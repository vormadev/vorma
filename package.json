{
	"name": "vorma",
	"version": "0.85.0-pre.1",
	"description": "The Golang metaframework, powered by Vite.",
	"type": "module",
	"sideEffects": false,
	"license": "BSD-3-Clause",
	"repository": {
		"url": "https://github.com/vormadev/vorma",
		"type": "git"
	},
	"bugs": {
		"url": "https://github.com/vormadev/vorma/issues"
	},
	"homepage": "https://vorma.dev",
	"author": "Samuel J. Cook",
	"keywords": [
		"react",
		"go",
		"golang",
		"framework",
		"typescript",
		"router",
		"preact",
		"solid",
		"meta-framework",
		"vite"
	],
	"exports": {
		"./client": {
			"import": "./npm_dist/typescript/vorma/client/index.js",
			"types": "./npm_dist/typescript/vorma/client/index.d.ts"
		},
		"./client/__internal": {
			"import": "./npm_dist/typescript/vorma/client/internal.js",
			"types": "./npm_dist/typescript/vorma/client/internal.d.ts"
		},
		"./buildtime": {
			"import": "./npm_dist/typescript/vorma/client/buildtime.js",
			"types": "./npm_dist/typescript/vorma/client/buildtime.d.ts"
		},
		"./react": {
			"import": "./npm_dist/typescript/vorma/ui-adapters/react/index.js",
			"types": "./npm_dist/typescript/vorma/ui-adapters/react/index.d.ts"
		},
		"./solid": {
			"import": "./npm_dist/typescript/vorma/ui-adapters/solid/index.js",
			"types": "./npm_dist/typescript/vorma/ui-adapters/solid/index.d.ts"
		},
		"./preact": {
			"import": "./npm_dist/typescript/vorma/ui-adapters/preact/index.js",
			"types": "./npm_dist/typescript/vorma/ui-adapters/preact/index.d.ts"
		},
		"./vite": {
			"import": "./npm_dist/typescript/vorma/vite/vite.js",
			"types": "./npm_dist/typescript/vorma/vite/vite.d.ts"
		},
		"./kit/converters": {
			"import": "./npm_dist/typescript/kit/converters/converters.js",
			"types": "./npm_dist/typescript/kit/converters/converters.d.ts"
		},
		"./kit/cookies": {
			"import": "./npm_dist/typescript/kit/cookies/cookies.js",
			"types": "./npm_dist/typescript/kit/cookies/cookies.d.ts"
		},
		"./kit/csrf": {
			"import": "./npm_dist/typescript/kit/csrf/csrf.js",
			"types": "./npm_dist/typescript/kit/csrf/csrf.d.ts"
		},
		"./kit/debounce": {
			"import": "./npm_dist/typescript/kit/debounce/debounce.js",
			"types": "./npm_dist/typescript/kit/debounce/debounce.d.ts"
		},
		"./kit/fmt": {
			"import": "./npm_dist/typescript/kit/fmt/fmt.js",
			"types": "./npm_dist/typescript/kit/fmt/fmt.d.ts"
		},
		"./kit/json": {
			"import": "./npm_dist/typescript/kit/json/json.js",
			"types": "./npm_dist/typescript/kit/json/json.d.ts"
		},
		"./kit/listeners": {
			"import": "./npm_dist/typescript/kit/listeners/listeners.js",
			"types": "./npm_dist/typescript/kit/listeners/listeners.d.ts"
		},
		"./kit/matcher/register": {
			"import": "./npm_dist/typescript/kit/matcher/register.js",
			"types": "./npm_dist/typescript/kit/matcher/register.d.ts"
		},
		"./kit/matcher/find-best": {
			"import": "./npm_dist/typescript/kit/matcher/find_best_match.js",
			"types": "./npm_dist/typescript/kit/matcher/find_best_match.d.ts"
		},
		"./kit/matcher/find-nested": {
			"import": "./npm_dist/typescript/kit/matcher/find_nested_matches.js",
			"types": "./npm_dist/typescript/kit/matcher/find_nested_matches.d.ts"
		},
		"./kit/theme": {
			"import": "./npm_dist/typescript/kit/theme/theme.js",
			"types": "./npm_dist/typescript/kit/theme/theme.d.ts"
		},
		"./kit/url": {
			"import": "./npm_dist/typescript/kit/url/url.js",
			"types": "./npm_dist/typescript/kit/url/url.d.ts"
		}
	},
	"files": [
		"npm_dist/",
		"LICENSE",
		"README.md",
		"tsconfig.base.json",
		"typescript/",
		"internal/site/frontend/assets/vorma-banner.webp",
		"!**/node_modules/",
		"!**/tmp/",
		"!**/tests/",
		"!**/pnpm-lock.yaml",
		"!**/*.test.*",
		"!**/*.bench.*"
	],
	"devDependencies": {
		"@preact/signals": "^2.8.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.19.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20250716.1",
		"@vitest/coverage-v8": "^4.0.18",
		"esbuild": "^0.25.12",
		"esbuild-plugin-solid": "^0.6.0",
		"history": "5.3.0",
		"jsdom": "^26.1.0",
		"oxlint": "^1.50.0",
		"preact": "^10.28.4",
		"prettier": "^3.8.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"solid-js": "^1.9.11",
		"typescript": "^5.9.3",
		"vite": "npm:rolldown-vite@latest",
		"vitest": "^4.0.18"
	},
	"prettier": {
		"useTabs": true,
		"tabWidth": 4,
		"proseWrap": "always"
	}
}
