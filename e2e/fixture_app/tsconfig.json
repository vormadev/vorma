{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	},
	"include": [
		"./frontend/src/**/*.ts",
		"./frontend/src/**/*.tsx",
		"./vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"./frontend/src_react/**",
		"./frontend/src_preact/**"
	]
}
