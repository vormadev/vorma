{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://vorma.dev/spec_templates/test-matrix.schema.json",
	"title": "Package Conformance Test Matrix",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "package", "purpose", "cases"],
	"properties": {
		"schema_version": {
			"type": "string",
			"const": "1.0.0"
		},
		"package": {
			"$ref": "#/$defs/nonEmptyString"
		},
		"purpose": {
			"type": "string",
			"const": "new-conformance-tests"
		},
		"cases": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"case_id",
					"req_id",
					"api_symbols",
					"type",
					"setup",
					"inputs",
					"expected",
					"notes"
				],
				"properties": {
					"case_id": {
						"type": "string",
						"pattern": "^CASE-[A-Z0-9-]+$"
					},
					"req_id": {
						"$ref": "#/$defs/reqId"
					},
					"api_symbols": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": {
							"$ref": "#/$defs/nonEmptyString"
						}
					},
					"type": {
						"type": "string",
						"enum": ["positive", "negative", "edge"]
					},
					"setup": {
						"type": "string",
						"minLength": 1,
						"allOf": [
							{
								"not": {
									"pattern": "\\.test\\."
								}
							}
						]
					},
					"inputs": {
						"type": "object",
						"minProperties": 1
					},
					"expected": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"return_value",
							"errors_or_status",
							"state_changes",
							"events_emitted",
							"network_io",
							"dom_effects"
						],
						"properties": {
							"return_value": {
								"type": "object",
								"additionalProperties": false,
								"required": ["kind"],
								"properties": {
									"kind": {
										"type": "string",
										"enum": ["concrete", "not_applicable"]
									},
									"value": {},
									"reason": {
										"type": "string",
										"enum": [
											"promise_rejected",
											"exception_thrown"
										]
									}
								},
								"allOf": [
									{
										"if": {
											"properties": {
												"kind": {
													"const": "concrete"
												}
											},
											"required": ["kind"]
										},
										"then": {
											"required": ["value"]
										}
									},
									{
										"if": {
											"properties": {
												"kind": {
													"const": "not_applicable"
												}
											},
											"required": ["kind"]
										},
										"then": {
											"required": ["reason"]
										}
									}
								]
							},
							"errors_or_status": {
								"type": "object",
								"additionalProperties": false,
								"required": ["mode", "detail"],
								"properties": {
									"mode": {
										"type": "string",
										"enum": [
											"none",
											"promise_rejected",
											"exception_thrown",
											"returned_error_status"
										]
									},
									"detail": {
										"$ref": "#/$defs/nonEmptyString"
									}
								}
							},
							"state_changes": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/assertionItem"
								}
							},
							"events_emitted": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/assertionItem"
								}
							},
							"network_io": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/assertionItem"
								}
							},
							"dom_effects": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/assertionItem"
								}
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"errors_or_status": {
											"properties": {
												"mode": {
													"const": "none"
												}
											},
											"required": ["mode"]
										}
									},
									"required": ["errors_or_status"]
								},
								"then": {
									"properties": {
										"return_value": {
											"properties": {
												"kind": {
													"const": "concrete"
												}
											},
											"required": ["kind"]
										}
									}
								}
							},
							{
								"if": {
									"properties": {
										"errors_or_status": {
											"properties": {
												"mode": {
													"const": "promise_rejected"
												}
											},
											"required": ["mode"]
										}
									},
									"required": ["errors_or_status"]
								},
								"then": {
									"properties": {
										"return_value": {
											"properties": {
												"kind": {
													"const": "not_applicable"
												},
												"reason": {
													"const": "promise_rejected"
												}
											},
											"required": ["kind", "reason"]
										}
									}
								}
							},
							{
								"if": {
									"properties": {
										"errors_or_status": {
											"properties": {
												"mode": {
													"const": "exception_thrown"
												}
											},
											"required": ["mode"]
										}
									},
									"required": ["errors_or_status"]
								},
								"then": {
									"properties": {
										"return_value": {
											"properties": {
												"kind": {
													"const": "not_applicable"
												},
												"reason": {
													"const": "exception_thrown"
												}
											},
											"required": ["kind", "reason"]
										}
									}
								}
							}
						]
					},
					"notes": {
						"type": "string",
						"minLength": 1,
						"allOf": [
							{
								"not": {
									"pattern": "\\.test\\."
								}
							}
						]
					}
				}
			}
		}
	},
	"$defs": {
		"nonEmptyString": {
			"type": "string",
			"minLength": 1
		},
		"reqId": {
			"type": "string",
			"pattern": "^REQ-[A-Z0-9-]+-[0-9]{3,4}$"
		},
		"assertionItem": {
			"type": "object",
			"minProperties": 1,
			"required": ["assertion"],
			"properties": {
				"assertion": {
					"type": "string",
					"minLength": 1
				}
			},
			"additionalProperties": true
		}
	}
}
