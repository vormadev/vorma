	"files": [
		".dist/",
		"README.md",
		"tsconfig.base.json",
		"kit/",
		"vorma/",
		"banner.webp",
		"!node_modules/",
		"!pnpm-lock.yaml",
		"!**/*.test.*",
		"!**/*.bench.*",
		"!vorma/tests/",
		"!vorma/core/___ccc_test_helpers.ts"
	]
}
