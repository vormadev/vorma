		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20260326.1",
		"jsdom": "^29.0.1",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"oxlint-tsgolint": "^0.20.0",
		"preact": "^10.29.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"solid-js": "^1.9.12",
		"tsdown": "^0.21.5",
		"typescript": "^6.0.2",
		"unplugin-solid": "^1.0.0",
		"vite": "^8.0.3",
		"vite-plugin-solid": "^2.11.11",
		"vitest": "^4.1.2"
