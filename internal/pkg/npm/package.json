{
	"name": "vorma",
	"version": "0.85.0-pre.11",
	"description": "Vorma seeks to be the world's most straightforward web framework.",
	"type": "module",
	"sideEffects": false,
	"license": "BSD-3-Clause",
	"repository": {
		"url": "https://github.com/vormadev/vorma",
		"type": "git"
	},
	"bugs": {
		"url": "https://github.com/vormadev/vorma/issues"
	},
	"homepage": "https://vorma.dev",
	"author": "Samuel J. Cook",
	"keywords": [
		"go",
		"golang",
		"typescript",
		"vite",
		"react",
		"preact",
		"solid",
		"framework",
		"metaframework",
		"meta-framework"
	],
	"exports": {
