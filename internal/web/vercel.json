{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "make vercel-install",
	"buildCommand": "make vercel-build",
	"outputDirectory": "dist/.wavedist/static/assets/public",
	"functions": {
		"api/proxy.rs": {
			"includeFiles": ["wave.config.json", "dist/.wavedist/main"]
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api/proxy"
		}
	],
	"headers": [
		{
			"source": "/wave_out_(.*).(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
