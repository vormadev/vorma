{
	"$schema": ".waveout/schema.json",
	"RootDir": "../",
	"Core": {
		"BinaryName": "main",
		"HealthcheckEndpoint": "/healthz",
		"PublicPathPrefix": "/",
		"StaticAssetDirs": {
			"Private": "backend/assets",
			"Public": "frontend/assets"
		},
		"CSSEntryFiles": {
			"Critical": "frontend/src/styles/main.critical.css",
			"NonCritical": "frontend/src/styles/main.css"
		}
	},
	"Vorma": {
		"MainBuildEntry": "backend/cmd/build",
		"UIVariant": "solid",
		"HTMLTemplateLocation": "entry.go.html",
		"ClientEntry": "frontend/src/vorma.entry.tsx",
		"ClientRouteDefinitionPatterns": ["frontend/src/**/*vorma.routes.ts"],
		"ServerRouteDefinitionPatterns": ["backend/src/**/*.go"],
		"TSGenOutDir": "frontend/src/vorma.gen",
		"BuildtimePublicURLFuncName": "hashedURL"
	},
	"Vite": {
		"JSPackageManagerBaseCmd": "pnpm"
	},
	"LifecycleHooks": [
		{
			"WatchIncludePatterns": ["backend/assets/markdown/**/*.md"],
			"Effects": ["revalidate_client_data"],
			"DevOnly": true
		},
		{
			"WatchIncludePatterns": ["**/README.md"],
			"Cmd": "go run ./backend/cmd/sync_docs",
			"StartAt": "cycle_start",
			"FinishBy": "cycle_start",
			"DevOnly": true
		},
		{
			"WatchIncludePatterns": ["frontend/assets/**/*"],
			"Cmd": "go run ./backend/cmd/sync_docs --rewrite-only",
			"StartAt": "go_compile",
			"FinishBy": "go_compile",
			"DevOnly": true
		}
	]
}
